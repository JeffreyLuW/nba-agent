# Copy this file to .env and fill in your own values.
# .env is in .gitignore. Never commit real keys.

# Which LLM to use, as "provider:model".
# Default: a free local model from Ollama (no API key needed).
LLM_MODEL=ollama:qwen3
# Where Ollama runs. docker-compose sets this to http://host.docker.internal:11434
# for the backend container. Without Docker, keep localhost.
OLLAMA_BASE_URL=http://localhost:11434
# qwen3 "thinking" mode: slow, and the page shows "..." while it thinks. Off by default.
OLLAMA_REASONING=false
# How much text the model can read at once (Ollama's default is too small for our tools).
OLLAMA_NUM_CTX=16384

# Paid providers (optional). To switch, set for example
#   LLM_MODEL=anthropic:claude-sonnet-5-5   or   LLM_MODEL=openai:gpt-5-mini
# and fill in that provider's key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: LangSmith tracing (free tier) to see every agent step.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nba-agent
