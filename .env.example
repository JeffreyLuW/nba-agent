# Copy this file to .env and fill in your own values.
# .env is in .gitignore. Never commit real keys.

# Which LLM to use, as "provider:model".
LLM_MODEL=anthropic:claude-sonnet-5-5
# Set the key for the provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: LangSmith tracing (free tier) to see every agent step.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nba-agent
